        android:fillColor="#00000000"
        android:pathData="M20,34 V26 A6,6 0 0 1 26,20 H34 M74,20 H82 A6,6 0 0 1 88,26 V34 M88,74 V82 A6,6 0 0 1 82,88 H74 M34,88 H26 A6,6 0 0 1 20,82 V74"
        android:strokeColor="#D81B60"
        android:strokeWidth="5" />

    <!-- 人民币符号：Y 形 -->
    <path
        android:fillColor="#D81B60"
        android:pathData="M41,38 L54,53 L67,38 V45 L54,60 L41,45 Z" />

    <!-- 人民币符号：竖笔 -->
    <path
        android:fillColor="#D81B60"
