<?xml version="1.0" encoding="utf-8"?>
<!-- 吹风机桌面快捷方式预设图标：叶子（给每台机器挑一个，铺在桌面上好认）。
     自带底色：浅色 / 深色桌面都能看清，也不依赖 Launcher 的图标底色。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 圆角底色 -->
    <path
        android:fillColor="#66BB6A"
        android:pathData="M0,24 A24,24 0 0 1 24,0 H84 A24,24 0 0 1 108,24 V84 A24,24 0 0 1 84,108 H24 A24,24 0 0 1 0,84 Z" />

    <!-- 图形主体（彩色底 + 白色图形：远看是一块彩色，近看能分辨） -->
    <path
        android:fillType="nonZero"
        android:fillColor="#FFFFFFFF"
        android:pathData="M26,84 C26,46 54,22 86,22 C86,60 58,84 26,84 Z" />
</vector>
