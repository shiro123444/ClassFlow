<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 圆角底色 -->
    <path
        android:fillColor="#29B6F6"
        android:pathData="M0,24 A24,24 0 0 1 24,0 H84 A24,24 0 0 1 108,24 V84 A24,24 0 0 1 84,108 H24 A24,24 0 0 1 0,84 Z" />

    <!-- 图形主体（彩色底 + 白色图形：远看是一块彩色，近看能分辨） -->
    <path
        android:fillType="nonZero"
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,18 C62,34 78,50 78,66 A24,24 0 0 1 30,66 C30,50 46,34 54,18 Z" />
</vector>
