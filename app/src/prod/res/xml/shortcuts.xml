<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面长按图标的静态快捷方式：扫一扫、一卡通（prod 变体）。
     显式指定 targetPackage 与 targetClass 为当前变体，避免与 dev 变体共存时系统弹出应用选择器。 -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_qr_scan"
        android:shortcutId="qr_scan"
        android:shortcutShortLabel="@string/shortcut_short_qr_scan">

        <intent
            android:action="com.xingheyuzhuan.shiguangschedule.action.QR_SCAN"
            android:targetPackage="com.shiro.classflow"
            android:targetClass="com.xingheyuzhuan.shiguangschedule.MainActivity" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_campus_card"
        android:shortcutId="campus_card"
        android:shortcutShortLabel="@string/shortcut_short_campus_card">

        <intent
            android:action="com.xingheyuzhuan.shiguangschedule.action.CAMPUS_CARD"
            android:targetPackage="com.shiro.classflow"
            android:targetClass="com.xingheyuzhuan.shiguangschedule.MainActivity" />
    </shortcut>
</shortcuts>
